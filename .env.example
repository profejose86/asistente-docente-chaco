# Variables públicas del cliente. No colocar service_role, sb_secret ni contraseñas.
# Cambiar a supabase después de configurar el proyecto y aplicar la migración.
ADC_AUTH_MODE=demo
SUPABASE_URL=
SUPABASE_ANON_KEY=
ADC_GOOGLE_AUTH_ENABLED=false
ADC_SITE_URL=http://127.0.0.1:8765/
# Sólo para piloto explícitamente autorizado. Fuera del piloto volver a true con SMTP.
ADC_EMAIL_CONFIRMATIONS_REQUIRED=true
ADC_PASSWORD_RECOVERY_ENABLED=true

# Correo del proveedor elegido. Estas variables son privadas y no van al frontend.
# Completar todas juntas para habilitar SMTP propio.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SENDER_EMAIL=
# SMTP_SENDER_NAME=Asistente Docente Chaco

# Sólo para herramientas administrativas locales, nunca para el navegador:
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
# SUPABASE_ORGANIZATION_SLUG=
